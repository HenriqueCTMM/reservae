PORT=3000
NODE_ENV=development
SESSION_SECRET=troque-por-uma-chave-aleatoria-longa
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=reservae
DB_PASSWORD=reservae_local
DB_NAME=reservae
DB_CONNECTION_LIMIT=10

# Produção: habilite TLS se o provedor exigir. A CA pode ser omitida
# quando o certificado do servidor já é confiável pelo Node.js.
DB_SSL=false
# Use somente uma opção de CA (PEM inline aceita \n como quebra de linha):
# DB_SSL_CA=
# DB_SSL_CA_FILE=/etc/secrets/mysql-ca.pem

# Usados apenas pelo comando npm run db:admin
ADMIN_NAME=Administrador
ADMIN_EMAIL=
ADMIN_PASSWORD=
