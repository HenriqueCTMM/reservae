<% weekDays.forEach((label, day) => { const schedule = operatingConfig.weekly[day]; %>
    <fieldset class="rounded-2xl border border-slate-200 p-4">
        <legend class="font-bold"><%= label %></legend>
        <label class="mt-3 flex items-center gap-2 text-sm font-medium">
            <input id="weekly-<%= day %>-open" type="checkbox" class="h-4 w-4 rounded border-slate-300" <%= schedule.open ? 'checked' : '' %> />
            Aberto neste dia
        </label>
        <div class="mt-3 grid gap-3 sm:grid-cols-2 xl:grid-cols-4">
            <% [0, 1].forEach((index) => { ['start', 'end'].forEach((field) => { %>
                <div>
                    <label for="weekly-<%= day %>-<%= index %>-<%= field %>" class="mb-1 block text-sm font-medium">Turno <%= index + 1 %> <%= field === 'start' ? 'início' : 'fim' %></label>
                    <input id="weekly-<%= day %>-<%= index %>-<%= field %>" type="time" step="60" value="<%= schedule.shifts[index]?.[field] || '' %>"
                        class="w-full rounded-xl border border-slate-300 px-3 py-2 outline-none transition focus:border-slate-900 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-slate-900" />
                </div>
            <% }); }); %>
        </div>
    </fieldset>
<% }); %>
