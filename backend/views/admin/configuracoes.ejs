<!DOCTYPE html>
<html lang="pt-BR">

<%- include('../partials/head') %>

<body class="app-surface flex min-h-screen flex-col text-slate-900">
    <a href="#conteudo-principal"
        class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-50 focus:rounded-xl focus:bg-white focus:px-4 focus:py-3 focus:text-sm focus:font-semibold focus:text-slate-900 focus:shadow-lg focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-slate-900">Pular
        para o conteúdo principal</a>

    <%- include('../partials/navigation', { pageTitle: 'Configurações', pageDescription: 'Funcionamento semanal e exceções', titleId: 'admin-page-title', activePage: '/admin/configuracoes' }) %>

    <main id="conteudo-principal" tabindex="-1" class="app-container flex-1 space-y-6 py-5 md:py-6"
        aria-labelledby="admin-page-title">
        <div id="adminMessage" class="hidden rounded-xl px-4 py-3 text-sm" aria-live="assertive" aria-atomic="true">
        </div>

        <article class="app-card rounded-2xl bg-white p-3 shadow-sm" aria-labelledby="operating-hours-title">
            <div class="mb-6">
                <h2 id="operating-hours-title" class="text-xl font-bold">Funcionamento do restaurante</h2>
                <p class="text-sm text-slate-500">Defina até dois turnos por dia. Antecedência mínima de 180 minutos e horários ofertados a cada 30 minutos.</p>
            </div>

            <div class="grid gap-6 lg:grid-cols-[1fr_0.9fr]">
                <form id="weeklyHoursForm" class="space-y-4" aria-labelledby="operating-hours-title">
                    <button id="reloadOperatingHoursButton" type="button"
                        class="rounded-xl border border-slate-300 px-4 py-2 text-sm font-semibold transition hover:bg-slate-100 disabled:opacity-50">Recarregar horários</button>
                    <fieldset id="weeklyHoursControls" class="space-y-4" <%= weeklyError ? 'disabled' : '' %>>
                        <legend class="sr-only">Horários semanais</legend>
                        <div id="weeklyHoursFields" data-initial-config="<%= JSON.stringify(operatingConfig) %>" class="space-y-3" aria-live="polite">
                            <% if (weeklyError) { %>
                                <p role="alert" class="rounded-2xl border border-rose-200 bg-rose-50 p-4 text-sm text-rose-700"><%= weeklyError %></p>
                            <% } else { %>
                                <%- include('weekly-hours') %>
                            <% } %>
                        </div>
                        <button type="submit"
                            class="rounded-xl bg-slate-900 px-4 py-3 font-semibold text-white transition hover:bg-slate-700 disabled:opacity-50 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-slate-900">Salvar
                            horários semanais</button>
                    </fieldset>
                </form>

                <div class="space-y-4">
                    <p class="text-sm text-slate-500">Uma exceção substitui o funcionamento semanal na data escolhida. Ao excluí-la, volta a valer a programação semanal.</p>
                    <div id="exceptionsMessage" class="hidden rounded-xl px-4 py-3 text-sm" aria-live="assertive" aria-atomic="true"></div>
                    <button id="reloadExceptionsButton" type="button"
                        class="rounded-xl border border-slate-300 px-4 py-2 text-sm font-semibold transition hover:bg-slate-100 disabled:opacity-50">Recarregar exceções</button>
                    <form id="exceptionForm" class="space-y-4 rounded-2xl border border-slate-200 p-3"
                        aria-label="Exceção de funcionamento">
                        <fieldset id="exceptionControls" class="space-y-4" <%= exceptionsError ? 'disabled' : '' %>>
                        <legend class="sr-only">Exceção de funcionamento</legend>
                        <div>
                            <label for="exceptionDate" class="mb-1 block text-sm font-medium">Data da exceção</label>
                            <input id="exceptionDate" type="date" min="1000-01-01" max="9999-12-31"
                                class="w-full rounded-xl border border-slate-300 px-4 py-3 outline-none transition focus:border-slate-900 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-slate-900"
                                required />
                        </div>
                        <div>
                            <label for="exceptionOpen" class="mb-1 block text-sm font-medium">Funcionamento</label>
                            <select id="exceptionOpen"
                                class="w-full rounded-xl border border-slate-300 px-4 py-3 outline-none transition focus:border-slate-900 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-slate-900">
                                <option value="true">Aberto com horário especial</option>
                                <option value="false">Fechado</option>
                            </select>
                        </div>
                        <div class="grid gap-3 sm:grid-cols-2">
                            <div>
                                <label for="exceptionShift1Start" class="mb-1 block text-sm font-medium">Turno 1
                                    início</label>
                                <input id="exceptionShift1Start" type="time" step="60"
                                    class="w-full rounded-xl border border-slate-300 px-4 py-3 outline-none transition focus:border-slate-900 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-slate-900" />
                            </div>
                            <div>
                                <label for="exceptionShift1End" class="mb-1 block text-sm font-medium">Turno 1
                                    fim</label>
                                <input id="exceptionShift1End" type="time" step="60"
                                    class="w-full rounded-xl border border-slate-300 px-4 py-3 outline-none transition focus:border-slate-900 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-slate-900" />
                            </div>
                            <div>
                                <label for="exceptionShift2Start" class="mb-1 block text-sm font-medium">Turno 2
                                    início</label>
                                <input id="exceptionShift2Start" type="time" step="60"
                                    class="w-full rounded-xl border border-slate-300 px-4 py-3 outline-none transition focus:border-slate-900 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-slate-900" />
                            </div>
                            <div>
                                <label for="exceptionShift2End" class="mb-1 block text-sm font-medium">Turno 2
                                    fim</label>
                                <input id="exceptionShift2End" type="time" step="60"
                                    class="w-full rounded-xl border border-slate-300 px-4 py-3 outline-none transition focus:border-slate-900 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-slate-900" />
                            </div>
                        </div>
                        <div>
                            <label for="exceptionReason" class="mb-1 block text-sm font-medium">Motivo (opcional)</label>
                            <input id="exceptionReason" type="text" maxlength="120"
                                class="w-full rounded-xl border border-slate-300 px-4 py-3 outline-none transition focus:border-slate-900 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-slate-900"
                                placeholder="Ex.: Feriado, evento especial" />
                        </div>
                        <div class="app-mobile-stack flex flex-wrap gap-3">
                            <button type="submit"
                                class="rounded-xl bg-slate-900 px-4 py-3 font-semibold text-white transition hover:bg-slate-700 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-slate-900">Salvar
                                exceção</button>
                            <button id="clearExceptionFormButton" type="button"
                                class="rounded-xl border border-slate-300 px-4 py-3 font-semibold transition hover:bg-slate-100 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-slate-900">Limpar</button>
                        </div>
                        </fieldset>
                    </form>

                    <div>
                        <h3 class="mb-3 font-bold">Exceções cadastradas</h3>
                        <div id="exceptionsList" data-initial-exceptions="<%= JSON.stringify(exceptions) %>" class="space-y-3" aria-live="polite">
                            <% if (exceptionsError) { %>
                                <p role="alert" class="rounded-2xl border border-rose-200 bg-rose-50 p-4 text-sm text-rose-700"><%= exceptionsError %></p>
                            <% } else if (!exceptions.length) { %>
                                <p class="rounded-2xl border border-slate-200 p-4 text-sm text-slate-500">Nenhuma exceção cadastrada.</p>
                            <% } else { exceptions.forEach((exception) => { %>
                                <article class="rounded-2xl border border-slate-200 p-4">
                                    <div class="flex flex-col gap-3 md:flex-row md:items-start md:justify-between">
                                        <div>
                                            <h4 class="font-bold"><%= formatDate(exception.date) %></h4>
                                            <p class="text-sm text-slate-600"><%= exception.open ? exception.shifts.map((shift) => `${shift.start} às ${shift.end}`).join(' e ') : 'Fechado' %></p>
                                            <p class="mt-1 text-xs text-slate-500"><%= exception.reason || 'Sem motivo informado' %></p>
                                        </div>
                                        <div class="flex flex-wrap gap-2">
                                            <button type="button" data-edit-exception="<%= exception.date %>" class="rounded-xl border border-slate-300 px-3 py-2 text-sm font-semibold transition hover:bg-slate-100 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-slate-900">Editar</button>
                                            <button type="button" data-delete-exception="<%= exception.date %>" class="rounded-xl border border-rose-200 px-3 py-2 text-sm font-semibold text-rose-600 transition hover:bg-rose-50 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-slate-900">Excluir</button>
                                        </div>
                                    </div>
                                </article>
                            <% }); } %>
                        </div>
                    </div>
                </div>
            </div>
        </article>
    </main>

    <%- include('../partials/footer') %>

    <script type="module" src="/js/admin.js"></script>
</body>

</html>
