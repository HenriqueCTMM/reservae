<!DOCTYPE html>
<html lang="pt-BR">
<%- include('../partials/head') %>
<body class="app-surface flex min-h-screen flex-col text-slate-900">
    <%- include('../partials/skip-link') %>
    <%- include('../partials/navigation', {
        pageTitle: 'Reservas', pageDescription: 'Acompanhe reservas e relatórios do restaurante',
        titleId: 'admin-page-title', activePage: '/admin/reservas'
    }) %>
    <main id="conteudo-principal" tabindex="-1" class="app-container flex-1 space-y-6 py-5 md:py-6" aria-labelledby="admin-page-title">
        <div id="adminMessage" class="hidden rounded-xl px-4 py-3 text-sm" aria-live="assertive" aria-atomic="true"></div>
        <article class="app-card rounded-2xl bg-white p-3 shadow-sm" aria-labelledby="admin-reservations-title">
            <div class="mb-4 flex flex-col gap-4 lg:flex-row lg:items-start lg:justify-between">
                <div><h2 id="admin-reservations-title" class="text-xl font-bold">Reservas do restaurante</h2><p class="text-sm text-slate-500">Visão completa das reservas criadas pelos clientes</p></div>
                <div class="app-mobile-stack flex flex-wrap gap-3">
                    <button id="refreshReservationsButton" type="button" class="rounded-xl border border-slate-300 px-4 py-2 text-sm font-semibold transition hover:bg-slate-100 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-slate-900">Atualizar</button>
                    <button id="clearReservationFiltersButton" type="button" class="rounded-xl border border-slate-300 px-4 py-2 text-sm font-semibold transition hover:bg-slate-100 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-slate-900">Limpar filtros</button>
                </div>
            </div>
            <form id="reservationFiltersForm" class="mb-4 grid gap-3 md:grid-cols-3" aria-label="Filtros de reservas">
                <div><label for="reservationDateFilter" class="mb-1 block text-sm font-medium">Data</label><input id="reservationDateFilter" type="date" class="w-full rounded-xl border border-slate-300 px-4 py-2 outline-none transition focus:border-slate-900 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-slate-900" /></div>
                <div><label for="reservationStatusFilter" class="mb-1 block text-sm font-medium">Status</label><select id="reservationStatusFilter" class="w-full rounded-xl border border-slate-300 px-4 py-2 outline-none transition focus:border-slate-900 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-slate-900"><%- include('status-options') %></select></div>
                <div><label for="reservationSearchFilter" class="mb-1 block text-sm font-medium">Nome, e-mail ou mesa</label><input id="reservationSearchFilter" type="search" maxlength="120" placeholder="Ex.: Maria ou Mesa 2" class="w-full rounded-xl border border-slate-300 px-4 py-2 outline-none transition focus:border-slate-900 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-slate-900" /></div>
                <div class="md:col-span-3"><button type="submit" class="rounded-xl bg-slate-900 px-4 py-2 text-sm font-semibold text-white transition hover:bg-slate-700 disabled:opacity-50">Aplicar filtros</button></div>
            </form>
            <p id="reservationResultsCount" class="mb-3 text-sm text-slate-500" aria-live="polite"><%= reservationsError ? 'Reservas não carregadas.' : `${reservations.length} ${reservations.length === 1 ? 'reserva encontrada' : 'reservas encontradas'}` %></p>
            <div class="app-scroll overflow-x-auto">
                <table class="min-w-full border-separate border-spacing-y-2" aria-labelledby="admin-reservations-title">
                    <thead><tr class="text-left text-sm text-slate-500"><% ['Cliente', 'Mesa', 'Data', 'Horário', 'Pessoas', 'Status', 'Finalização'].forEach((label) => { %><th scope="col" class="px-3 py-2"><%= label %></th><% }); %></tr></thead>
                    <tbody id="adminReservationsTable" aria-busy="false">
                        <% if (reservationsError) { %>
                            <tr><td colspan="7" role="alert" class="rounded-2xl bg-rose-50 px-3 py-4 text-center text-sm text-rose-700"><%= reservationsError %></td></tr>
                        <% } else if (!reservations.length) { %>
                            <tr><td colspan="7" class="rounded-2xl bg-slate-50 px-3 py-4 text-center text-sm text-slate-500">Nenhuma reserva encontrada para os filtros atuais.</td></tr>
                        <% } else { %>
                            <% reservations.forEach((reservation) => { %><%- include('reservation-row', { reservation, isReport: false }) %><% }); %>
                        <% } %>
                    </tbody>
                </table>
            </div>
        </article>
        <article class="app-card rounded-2xl bg-white p-3 shadow-sm" aria-labelledby="reservation-report-title">
            <div class="mb-4"><h2 id="reservation-report-title" class="text-xl font-bold">Relatório de reservas</h2><p class="text-sm text-slate-500">Totais e reservas calculados pelo servidor. Gere novamente após alterar reservas; os filtros do relatório são independentes da listagem acima.</p></div>
            <div id="reportMessage" class="mb-4 hidden rounded-xl px-4 py-3 text-sm" aria-live="assertive" aria-atomic="true"></div>
            <form id="reservationReportForm" class="mb-4 grid gap-3 md:grid-cols-4" aria-label="Filtros do relatório de reservas">
                <fieldset id="reportControls" class="contents">
                    <div><label for="reportStartDate" class="mb-1 block text-sm font-medium">Data inicial</label><input id="reportStartDate" type="date" class="w-full rounded-xl border border-slate-300 px-4 py-2 outline-none transition focus:border-slate-900 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-slate-900" /></div>
                    <div><label for="reportEndDate" class="mb-1 block text-sm font-medium">Data final</label><input id="reportEndDate" type="date" class="w-full rounded-xl border border-slate-300 px-4 py-2 outline-none transition focus:border-slate-900 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-slate-900" /></div>
                    <div><label for="reportStatusFilter" class="mb-1 block text-sm font-medium">Status</label><select id="reportStatusFilter" class="w-full rounded-xl border border-slate-300 px-4 py-2 outline-none transition focus:border-slate-900 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-slate-900"><%- include('status-options') %></select></div>
                    <div><label for="reportSearchFilter" class="mb-1 block text-sm font-medium">Nome, e-mail ou mesa</label><input id="reportSearchFilter" type="search" maxlength="120" placeholder="Ex.: Maria ou Mesa 2" class="w-full rounded-xl border border-slate-300 px-4 py-2 outline-none transition focus:border-slate-900 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-slate-900" /></div>
                    <div class="flex flex-wrap gap-3 md:col-span-4"><button type="submit" class="rounded-xl bg-slate-900 px-4 py-2 text-sm font-semibold text-white transition hover:bg-slate-700 disabled:opacity-50">Gerar / atualizar relatório</button><button id="clearReportFiltersButton" type="button" class="rounded-xl border border-slate-300 px-4 py-2 text-sm font-semibold transition hover:bg-slate-100 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-slate-900">Limpar filtros do relatório</button></div>
                </fieldset>
            </form>
            <p id="reportFiltersSummary" class="mb-3 text-sm text-slate-500" aria-live="polite"><%= report ? 'Última consulta: de qualquer data até qualquer data; status: Todos; busca: sem busca.' : 'Relatório não carregado.' %></p>
            <div id="reservationReportTotals" class="mb-4 grid grid-cols-2 gap-3 sm:grid-cols-3" aria-live="polite">
                <% if (report) { %>
                    <% [['Ativas', report.totals.ativa], ['Finalizadas', report.totals.finalizada], ['Canceladas', report.totals.cancelada], ['Não compareceu', report.totals.nao_compareceu], ['Total', report.totals.total]].forEach(([label, value]) => { %>
                        <div class="rounded-2xl border border-slate-200 bg-slate-50 p-4"><p class="text-xs font-semibold uppercase tracking-wide text-slate-500"><%= label %></p><p class="mt-2 text-2xl font-bold"><%= value %></p></div>
                    <% }); %>
                <% } %>
            </div>
            <div class="app-scroll overflow-x-auto">
                <table class="min-w-full border-separate border-spacing-y-2" aria-labelledby="reservation-report-title">
                    <thead><tr class="text-left text-sm text-slate-500"><% ['Cliente', 'Mesa', 'Reserva', 'Status', 'Atualização', 'Motivo'].forEach((label) => { %><th scope="col" class="px-3 py-2"><%= label %></th><% }); %></tr></thead>
                    <tbody id="reservationReportTable" aria-busy="false">
                        <% if (reportError) { %>
                            <tr><td colspan="6" role="alert" class="rounded-2xl bg-rose-50 px-3 py-4 text-center text-sm text-rose-700"><%= reportError %></td></tr>
                        <% } else if (!report.reservations.length) { %>
                            <tr><td colspan="6" class="rounded-2xl bg-slate-50 px-3 py-4 text-center text-sm text-slate-500">Nenhuma reserva encontrada para o relatório.</td></tr>
                        <% } else { %>
                            <% report.reservations.forEach((reservation) => { %><%- include('reservation-row', { reservation, isReport: true }) %><% }); %>
                        <% } %>
                    </tbody>
                </table>
            </div>
        </article>
    </main>
    <%- include('../partials/footer') %>
    <script type="module" src="/js/admin.js"></script>
</body>
</html>
