<% if (error) { %>
    <div class="mb-4 rounded-xl bg-rose-50 px-4 py-3 text-sm text-rose-700" role="alert">
        <%= error %>
    </div>
<% } %>
<% if (success) { %>
    <div class="mb-4 rounded-xl bg-emerald-50 px-4 py-3 text-sm text-emerald-700" role="status">
        <%= success %>
    </div>
<% } %>
