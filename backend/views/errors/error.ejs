<!DOCTYPE html>
<html lang="pt-BR">

<%- include('../partials/head') %>

<body class="app-surface flex min-h-screen flex-col text-slate-900">
    <%- include('../partials/skip-link') %>
    <%- include('../partials/navigation') %>

    <main id="conteudo-principal" tabindex="-1" class="app-container flex flex-1 items-center justify-center py-8" aria-labelledby="error-title">
        <section class="app-card w-full max-w-xl rounded-2xl bg-white p-6 shadow-lg">
            <h1 id="error-title" class="text-2xl font-bold">Erro <%= status %></h1>
            <p class="mt-4 text-slate-600" role="alert"><%= message %></p>
            <a href="/" class="mt-6 inline-block rounded-xl bg-slate-900 px-4 py-3 font-semibold text-white hover:bg-slate-700">Voltar ao início</a>
        </section>
    </main>

    <%- include('../partials/footer') %>
</body>

</html>
