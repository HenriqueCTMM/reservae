<!DOCTYPE html>
<html lang="pt-BR">

<%- include('../partials/head') %>

<body class="app-surface flex min-h-screen flex-col text-slate-900">
    <%- include('../partials/skip-link') %>

    <header class="border-b border-slate-200 bg-white">
        <div class="app-container flex items-center justify-between gap-4 py-4">
            <a href="/login" aria-label="Voltar para o login">
                <img src="/assets/logo-reservae.png" alt="Reservaê" class="h-10 w-auto" />
            </a>
            <img src="/assets/logo-bistro.jpeg" alt="Dona Maragô Bistrô" class="h-12 w-12 rounded-md object-cover" />
        </div>
    </header>

    <main id="conteudo-principal" tabindex="-1"
        class="app-container flex flex-1 items-center justify-center py-8 sm:py-10" aria-labelledby="register-title">
        <section class="app-auth-card app-card w-full max-w-md rounded-2xl bg-white p-6 shadow-lg sm:p-8"
            aria-labelledby="register-title">
            <div class="mb-8 text-center">
                <h1 id="register-title" class="text-3xl font-bold">Criar conta</h1>
                <p class="mt-2 text-sm text-slate-500">Cadastre-se como cliente para reservar mesas</p>
            </div>

            <%- include('../partials/form-message') %>

            <form id="registerForm" action="/cadastro" method="post" class="space-y-4" aria-labelledby="register-title">
                <div>
                    <label for="nome" class="mb-1 block text-sm font-medium">Nome</label>
                    <input id="nome" name="nome" type="text" autocomplete="name"
                        class="w-full rounded-xl border border-slate-300 px-4 py-3 outline-none transition focus:border-slate-900 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-slate-900"
                        placeholder="Digite seu nome" maxlength="120" value="<%= fields.nome %>" required />
                </div>
                <div>
                    <label for="email" class="mb-1 block text-sm font-medium">E-mail</label>
                    <input id="email" name="email" type="email" autocomplete="email"
                        class="w-full rounded-xl border border-slate-300 px-4 py-3 outline-none transition focus:border-slate-900 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-slate-900"
                        placeholder="Digite seu e-mail" maxlength="254" value="<%= fields.email %>" required />
                </div>
                <div>
                    <label for="senha" class="mb-1 block text-sm font-medium">Senha</label>
                    <input id="senha" name="senha" type="password" minlength="6" autocomplete="new-password"
                        aria-describedby="passwordHelp"
                        class="w-full rounded-xl border border-slate-300 px-4 py-3 outline-none transition focus:border-slate-900 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-slate-900"
                        placeholder="Mínimo de 6 caracteres" required />
                    <p id="passwordHelp" class="mt-1 text-sm text-slate-500">Use pelo menos 6 caracteres e no máximo 72 bytes.</p>
                </div>
                <button type="submit"
                    class="w-full rounded-xl bg-slate-900 px-4 py-3 font-semibold text-white transition hover:bg-slate-700 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-slate-900">Cadastrar</button>
            </form>

            <p class="mt-6 text-center text-sm text-slate-600">
                Já tem conta?
                <a href="/login"
                    class="font-semibold text-slate-900 underline-offset-4 hover:underline focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-slate-900">Voltar
                    para o login</a>
            </p>
        </section>
    </main>

    <%- include('../partials/footer') %>
</body>

</html>
